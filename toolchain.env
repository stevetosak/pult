# The Android toolchain that binds the Core, pinned (ADR 0001). gomobile and
# gobind are pinned in go.mod as tools.
#
# Each value is a package of Google's SDK repository,
# https://dl.google.com/android/repository/repository2-3.xml, read on
# 2026-11-27: the newest stable, non-preview version. To change one, read the
# repository again, edit the line, run the install command that
# `make toolchain-check` prints, then `make bind`.
#
# The Makefile includes this file; a CI job can read the same KEY=value lines.

# cmdline-tools;latest (sdkmanager)
ANDROID_CMDLINE_TOOLS=23.0
# platforms;<value>
ANDROID_PLATFORM=android-37.2
# ndk;<value>
ANDROID_NDK=30.0.16248370
# The lowest Android API level the Core supports: gomobile bind -androidapi,
# and later the app's minSdk. BiometricPrompt with the device credential
# needs 30; the app's design sets the final value.
ANDROID_MIN_API=30
